+    pub fn notify_zedg_selection(
+        &self,
+        buffer: &Entity<Buffer>,
+        selection: Option<String>,
+        cx: &mut Context<Self>,
+    ) {
+        self.lsp_store.update(cx, |lsp_store, cx| {
+            lsp_store.notify_zedg_selection(buffer, selection, cx)
