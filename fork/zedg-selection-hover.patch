+    /// ZedG: tell every `hover-translate-lsp` language server for this buffer about
+    /// the selection state, so translation bubbles only appear for selections.
+    /// Sent immediately before each hover request (FIFO over the same channel).
+    pub fn notify_zedg_selection(
+        &mut self,
+        buffer: &Entity<Buffer>,
+        selection: Option<String>,
+        cx: &mut Context<Self>,
+    ) {
+        let Some(local) = self.as_local() else {
+            return;
+        };
+        let servers = buffer.update(cx, |buffer, cx| {
+            local
+                .language_servers_for_buffer(buffer, cx)
+                .filter(|(adapter, _)| <_ as AsRef<str>>::as_ref(&adapter.name) == "hover-translate-lsp")
+                .map(|(_, server)| server.clone())
+                .collect::<Vec<_>>()
+        });
+        if servers.is_empty() {
+            return;
+        }
+        let Some(file) = File::from_dyn(buffer.read(cx).file()).and_then(File::as_local) else {
+            return;
+        };
+        let Ok(uri) = crate::lsp_command::make_text_document_identifier(&file.abs_path(cx)) else {
+            return;
+        };
+        for server in servers {
+            let _ = server.notify::<crate::lsp_command::ZedgSelectionChanged>(
+                crate::lsp_command::ZedgSelectionParams {
+                    uri: uri.uri.to_string(),
+                    text: selection.clone(),
+                },
+            );
+        }
+    }
